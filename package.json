{
  "name": "qyris",
  "private": true,
  "version": "0.1.0",
  "description": "轻驭 (Qyris) — Electron 桌面开发工作台（预览 / 文件 / AI 对话）",
  "repository": "https://github.com/winstly/Qyris.git",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "smoke:pty": "esbuild scripts/smoke-pty.ts --bundle --platform=node --format=cjs --external:node-pty --outfile=node_modules/.cache/smoke-pty.cjs && node node_modules/.cache/smoke-pty.cjs",
    "smoke:pty-registry": "esbuild scripts/smoke-pty-registry.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:node-pty --outfile=node_modules/.cache/smoke-pty-registry.cjs && node node_modules/.cache/smoke-pty-registry.cjs",
    "smoke:git": "esbuild scripts/smoke-git.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --outfile=node_modules/.cache/smoke-git.cjs && node node_modules/.cache/smoke-git.cjs",
    "smoke:protocol": "esbuild scripts/smoke-ai-protocol.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --outfile=node_modules/.cache/smoke-ai-protocol.cjs && node node_modules/.cache/smoke-ai-protocol.cjs",
    "smoke:runner-mcp": "esbuild scripts/smoke-runner-mcp.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:better-sqlite3 --external:sqlite-vec --external:@huggingface/transformers --external:onnxruntime-web --external:sharp --outfile=node_modules/.cache/smoke-runner-mcp.cjs && node node_modules/.cache/smoke-runner-mcp.cjs",
    "smoke:host-proxy": "esbuild scripts/smoke-host-proxy.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:better-sqlite3 --external:sqlite-vec --external:@huggingface/transformers --external:onnxruntime-web --external:sharp --outfile=node_modules/.cache/smoke-host-proxy.cjs && node node_modules/.cache/smoke-host-proxy.cjs",
    "smoke:workspace-tools": "esbuild scripts/smoke-workspace-tools.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:better-sqlite3 --external:sqlite-vec --external:@huggingface/transformers --external:onnxruntime-web --external:sharp --outfile=node_modules/.cache/smoke-workspace-tools.cjs && node node_modules/.cache/smoke-workspace-tools.cjs",
    "smoke:env": "esbuild scripts/smoke-env.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --outfile=node_modules/.cache/smoke-env.cjs && node node_modules/.cache/smoke-env.cjs",
    "smoke:memory": "esbuild scripts/smoke-memory.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:better-sqlite3 --external:sqlite-vec --external:@huggingface/transformers --external:onnxruntime-web --outfile=node_modules/.cache/smoke-memory.cjs && node node_modules/.cache/smoke-memory.cjs",
    "smoke:memory-agent": "esbuild scripts/smoke-memory-agent.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:better-sqlite3 --external:sqlite-vec --external:@huggingface/transformers --external:onnxruntime-web --outfile=node_modules/.cache/smoke-memory-agent.cjs && node node_modules/.cache/smoke-memory-agent.cjs",
    "smoke:pet": "esbuild scripts/smoke-pet-panel.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --outfile=node_modules/.cache/smoke-pet-panel.cjs && node node_modules/.cache/smoke-pet-panel.cjs",
    "ssh:diagnose": "esbuild scripts/ssh-diagnose.ts --bundle --platform=node --format=cjs --external:electron --external:ssh2 --outfile=node_modules/.cache/ssh-diagnose.cjs && npx electron node_modules/.cache/ssh-diagnose.cjs",
    "ssh:probe": "esbuild scripts/ssh-repro-probe.ts --bundle --platform=node --format=cjs --alias:electron=./scripts/electron-stub.ts --external:ssh2 --outfile=node_modules/.cache/ssh-repro-probe.cjs && node node_modules/.cache/ssh-repro-probe.cjs",
    "dist": "electron-vite build && electron-builder && node scripts/verify-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.2.0-beta.15",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.17.0"
  }
}
